-runTest and Virtual Time
-
-• runTest skips delays by advancing a virtual clock
-• StandardTestDispatcher queues work until you advance it
-• UnconfinedTestDispatcher runs eagerly, useful for simple state tests
-• Never use real delays or Thread.sleep in tests
-
-                                                                                                                                                                                                ©Logical Imagination Group LLC
-runTest and Virtual Time
-
-@Test
-
-fun retryBacksOffExponentially() = runTest {
-
-   var attempts = 0
-
-   val result = async {
-
-       retryGet(times = 3) { attempts++; if (attempts < 3) throw IOException() else "ok" }
-
-   }
-
-   advanceUntilIdle()    // skips all the delays instantly
-
-   assertEquals("ok", result.await())
-
-   assertTrue(currentTime >= 500) // virtual time really elapsed
-
-}
